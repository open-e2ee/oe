{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-e2ee/oe/releases/latest/download/config-v2.json",
  "title": "OpenE2EE project configuration",
  "description": "The value that open-e2ee.config.ts exports as its default.",
  "type": "object",
  "additionalProperties": false,
  "required": ["product", "project", "relay", "environments"],
  "properties": {
    "product": { "enum": ["signal-relay"] },
    "project": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "relay": { "$ref": "#/$defs/relayPolicy" },
    "environments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sandbox"],
      "properties": {
        "sandbox": { "$ref": "#/$defs/environment" },
        "production": { "$ref": "#/$defs/environment" }
      }
    }
  },
  "$defs": {
    "retention": {
      "enum": ["1h", "6h", "12h", "1d", "3d", "7d", "14d", "30d"]
    },
    "relayReceipts": {
      "description": "Turns Relay delivery receipts on or off. The shared policy is true when it leaves the field out.",
      "type": "boolean"
    },
    "relayPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliveryRetention", "attachmentRetention"],
      "properties": {
        "deliveryRetention": { "$ref": "#/$defs/retention" },
        "attachmentRetention": { "$ref": "#/$defs/retention" },
        "relayReceipts": { "$ref": "#/$defs/relayReceipts" }
      }
    },
    "relayOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deliveryRetention": { "$ref": "#/$defs/retention" },
        "attachmentRetention": { "$ref": "#/$defs/retention" },
        "relayReceipts": { "$ref": "#/$defs/relayReceipts" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relay": { "$ref": "#/$defs/relayOverride" }
      }
    }
  }
}
